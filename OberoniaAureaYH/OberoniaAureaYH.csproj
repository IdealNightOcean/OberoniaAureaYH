<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OberoniaAurea</RootNamespace>
    <AssemblyName>OberoniaAureaYH</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>Release\</OutputPath>
  </PropertyGroup>

  <!-- 定义Mod输出根路径，带[]特殊字符，单独放属性 -->
  <PropertyGroup>
    <RimWorldModAssemblyDir>E:\ProgramFiles\Steam\steamapps\common\RimWorld\Mods\[OA]Ratkin Faction Oberonia Aurea\1.7\Assemblies</RimWorldModAssemblyDir>
  </PropertyGroup>

  <!-- 引用暂未迁移：0Harmony、Assembly-CSharp、NightOcean、UnityEngine.* 等待后续处理 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>Release\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
    <DocumentationFile>OberoniaAurea_Frame.xml</DocumentationFile>
    <!-- 使用Path.GetFullPath求值，避免MSBuild直接解析[]为通配符 -->
    <OutputPath>$([System.IO.Path]::GetFullPath($(RimWorldModAssemblyDir)))</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="docs\**" />
    <EmbeddedResource Remove="docs\**" />
    <None Remove="docs\**" />
  </ItemGroup>

